API_PORT=8100
FRONTEND_PORT=8090
DATABASE_URL=sqlite:////data/smartbot.db

# Cambiar antes de desplegar fuera del equipo local.
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Credenciales exigidas para la evaluacion.
ADMIN_USERNAME=IA1-User
ADMIN_PASSWORD=IA1-password@_new

# Telegram: el token nunca debe versionarse con un valor real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_POLL_SECONDS=2
API_BASE_URL=http://api-gateway:8000
